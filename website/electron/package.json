{
  "name": "roycrew",
  "version": "0.3.0-roycrew.1",
  "description": "RoyCrew — AI agent desktop app (fork of Kiro Crew)",
  "homepage": "https://github.com/roy-kim-33/KiroCrew",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js mochi/test/*.test.js crew-companion/test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1"
  },
  "build": {
    "appId": "com.roykim.roycrew",
    "productName": "RoyCrew",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "x64ArchFiles": "{**/backend-dist/**,**/backend-dist/**/.*/**}",
      "extendInfo": {
        "CFBundleDisplayName": "RoyCrew",
        "NSMicrophoneUsageDescription": "RoyCrew uses the microphone for voice input and dictation in chat. Audio is captured only while you hold or toggle the mic button."
      }
    },
    "afterSign": "scripts/notarize.js",
    "linux": {
      "category": "Development",
      "icon": "icon.png",
      "synopsis": "RoyCrew — AI agent desktop app",
      "description": "RoyCrew is an open source development workspace (fork of Kiro Crew) that runs locally or remotely on your hardware. This fork re-enables the claude_code provider for custom LLM routers.",
      "maintainer": "Roy Kim <roy-kim-33@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "files": [
      "main.js",
      "app-menu.js",
      "windows-menu-model.js",
      "windows-titlebar.js",
      "badge.js",
      "native-theme.js",
      "zoom.js",
      "instance-guard.js",
      "context-menu.js",
      "find-bin.js",
      "data-home.js",
      "auto-update.js",
      "bundle-location.js",
      "gateway-auth-hint.js",
      "blocking-prompt.js",
      "gateway-stop.js",
      "gateway-wait.js",
      "sandbox-profile.js",
      "home-dir.js",
      "local-token.js",
      "local-gateway.js",
      "window-state.js",
      "linux-frame.js",
      "global-hotkey.js",
      "gateway-liveness.js",
      "gateway-recovery.js",
      "pyspy-dump.js",
      "perf-metrics.js",
      "host-config.js",
      "remote-token.js",
      "token-acquire.js",
      "token-retry.js",
      "display-media.js",
      "permission-handler.js",
      "browser-view.js",
      "browser-control.js",
      "browser-ops.js",
      "browser-agent-channel.js",
      "external-scheme.js",
      "validation.js",
      "context-menu.js",
      "preload.js",
      "mochi/index.js",
      "mochi/petOverlays.js",
      "mochi/pet-preload.js",
      "mochi/panelWindow.js",
      "mochi/avatarWindow.js",
      "mochi/settingsWindow.js",
      "mochi/snipWindow.js",
      "mochi/shortcuts.js",
      "mochi/pageUrl.js",
      "mochi/instanceGate.js",
      "mochi/machineStore.js",
      "crew-companion/index.js",
      "crew-companion/petOverlay.js",
      "crew-companion/pageUrl.js",
      "crew-companion/pet-preload.js",
      "crew-companion/panelWindow.js",
      "crew-companion/panelPlacement.js",
      "crew-companion/galleryWindow.js",
      "anime.global.js",
      "loading.html",
      "token-prompt.html",
      "icon.png",
      "icon-nightly.png",
      "trayTemplate.png",
      "trayTemplate@2x.png"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend-dist",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "roy-kim-33",
        "repo": "KiroCrew"
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis"
      ],
      "signtoolOptions": {
        "sign": "./scripts/sign-windows.js"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "author": "Kiro Crew"
}
